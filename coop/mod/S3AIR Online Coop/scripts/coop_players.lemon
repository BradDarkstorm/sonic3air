//-------------------------------------------------------//
// Online Co-op: see the other players                   //
//-------------------------------------------------------//

// How it works:
//  - Each game records the exact sprites it drew for its own character this frame (engine "sprite capture",
//    using the sprite tag the game sets to the object address before rendering it). That includes whatever
//    character mods drew, no matter how they work internally.
//  - These sprites (by their sprite key) plus the character's palette are sent to everyone.
//  - Other games redraw exactly those sprites, using the sender's palette in a spare palette line.
//    If a viewer doesn't have a sprite (e.g. doesn't have that character mod), it draws the original character instead.

global u8   Coop.players.sendCounter
global u32  Coop.players.tailsTailsAddress		// Cached address of player 1's Tails' tails object
global bool Coop.players.captureActive
global u8   Coop.players.captureCount		// Number of own sprites captured last frame
global u16  Coop.players.emptyCaptures		// Consecutive frames without any captured sprites


function void Coop.playersUpdate()
{
	if (!Net.isOnline())
	{
		// Forget everyone
		for (u8 id = 0; id < COOP_MAX_PLAYERS; ++id)
			u8[Coop.getPlayerBlock(id)] = 0
		if (Coop.players.captureActive)
		{
			Net.setCaptureTag(0, 0)
			Net.setCaptureTag(1, 0)
			Coop.players.captureActive = false
		}
		return
	}

	// Age remote player data, drop players without updates for 3 seconds or who left
	for (u8 id = 0; id < COOP_MAX_PLAYERS; ++id)
	{
		u32 block = Coop.getPlayerBlock(id)
		if (u8[block] == 0)
			continue

		u16[block + 2] += 1
		if (u16[block + 2] > 180 || !Net.isPlayerConnected(id) || id == Net.getLocalPlayerId())
			u8[block] = 0
	}

	if (!Coop.isInLevel())
		return

	// Capture the sprites of the own character object, and of Tails' tails if there are any
	Net.setCaptureTag(0, 0xffffb000)
	A0 = 0xffffb000
	u32 tailsAddress = (char.character == CHARACTER_TAILS) ? Coop.findTailsTails() : 0
	Net.setCaptureTag(1, tailsAddress)
	Coop.players.captureActive = true

	// What did our game draw for our character last frame?
	//  -> While paused, the game doesn't redraw anything, so keep sending as visible and don't replace the last sprites
	bool paused = (global.game.paused != 0)
	if (!paused)
	{
		Coop.players.captureCount = Net.getCapturedSprites(COOP_MEM_SEND2 + 4, MAX_SPRITES)
		if (Coop.players.captureCount == 0)
			Coop.players.emptyCaptures = min(Coop.players.emptyCaptures + 1, 1000)
		else
			Coop.players.emptyCaptures = 0
	}

	// Send own state every 2nd frame (30 per second), palette every 8th frame
	++Coop.players.sendCounter
	if ((Coop.players.sendCounter & 1) == 0)
	{
		Coop.sendPresence()
		if (!paused)
			Coop.sendSprites()
	}
	if ((Coop.players.sendCounter & 7) == 0)
	{
		Coop.sendPalette()
	}

	Coop.updateRemotePalettes()
	Coop.drawRemotePlayers()
}


function void Coop.sendPresence()
{
	A0 = 0xffffb000
	if (objA0.update_address == 0)
		return

	u32 msg = COOP_MEM_SEND
	u8[msg + 0x00] = MSG_PRESENCE
	u8[msg + 0x01] = char.character
	u16[msg + 0x02] = global.zone_act.apparent
	u16[msg + 0x04] = char.position.x.u16
	u16[msg + 0x06] = char.position.y.u16
	u16[msg + 0x08] = timeattack.animSpriteEx		// Written by the game's own character rendering each frame
	u8[msg + 0x0a] = char.animation.sprite
	u8[msg + 0x0b] = char.rotation

	u8 flags = (char.render_flags & 0x03)
	if (char.sprite_attributes & sprite_attribute.PRIORITY)
		flags |= PRESENCE_FLAG_PRIORITY
	bool isSuper = (char.character == CHARACTER_TAILS) ? (super.active.tails != 0) : (super.active != 0)
	if (isSuper)
		flags |= PRESENCE_FLAG_SUPER
	if (global.zone_act != global.zone_act.apparent)
		flags |= PRESENCE_FLAG_ACT_TRANS
	if (char.flags & char.flag.FACING_LEFT)
		flags |= PRESENCE_FLAG_FACING_LEFT

	// Visible = our game actually drew the character last frame (so blinking after a hit matches exactly)
	//  -> If sprite capture doesn't seem to work at all (nothing captured for a while), fall back to the blink timer
	bool visible
	if (global.game.paused != 0)
	{
		visible = true
	}
	else if (Coop.players.emptyCaptures < 30)
	{
		visible = (Coop.players.captureCount > 0)
	}
	else
	{
		visible = (u8[A0 + 0x34] == 0 || ((u8[A0 + 0x34] + 1) & 0x04) != 0)
	}
	if (visible)
		flags |= PRESENCE_FLAG_VISIBLE
	u8[msg + 0x0c] = flags

	// Tails' tails (only used for the fallback drawing)
	u8[msg + 0x0d] = 0
	u8[msg + 0x0e] = 0
	if (char.character == CHARACTER_TAILS)
	{
		u32 tailsAddress = Coop.findTailsTails()
		if (tailsAddress != 0)
		{
			u8[msg + 0x0d] = u8[tailsAddress + 0x22]
			u8[msg + 0x0e] = lookupAngleByVector(char.velocity.x, char.velocity.y)
		}
	}
	if (u8[0xffffb005] >= base_state.DIED)
		flags |= PRESENCE_FLAG_DEAD
	u8[msg + 0x0c] = flags
	u8[msg + 0x0f] = (level.boss_encounter != 0) ? PRESENCE_FLAG2_IN_BOSS : 0
	u16[msg + 0x10] = u16[0xffffb046]		// Collision layer
	u16[msg + 0x12] = char.sprite_attributes

	Net.send(NET_TARGET_ALL, msg, PRESENCE_SIZE, false)
}


function void Coop.sendSprites()
{
	// Sprites were already written to the buffer this frame, see "Coop.playersUpdate"
	u32 msg = COOP_MEM_SEND2
	u8 count = Coop.players.captureCount
	u8[msg + 0] = MSG_SPRITES
	u8[msg + 1] = count
	u16[msg + 2] = 0
	Net.send(NET_TARGET_ALL, msg, 4 + u16(count) * 0x20, false)
}


function void Coop.sendPalette()
{
	A0 = 0xffffb000
	u8 character = min(char.character, CHARACTER_KNUCKLES)
	u32 msg = COOP_MEM_SEND
	u8[msg + 0] = MSG_PALETTE
	u8[msg + 1] = character
	u16[msg + 2] = 0
	copyMemory(msg + 4, 0x802000 + u32(character) * 0x40, 0x40)		// Character palette lines, as currently shown (incl. fading / Super flashing)
	Net.send(NET_TARGET_ALL, msg, 0x44, false)
}


function u32 Coop.findTailsTails()
{
	// Check cached address first
	u32 address = Coop.players.tailsTailsAddress
	if (address != 0 && u32[address + 0x0c] == 0x344bb8 && u16[address + 0x30] == 0xb000)
		return address

	for (address = 0xffffb04a; address < 0xffffcfcb; address += 0x4a)
	{
		if (u32[address + 0x0c] == 0x344bb8 && u16[address + 0x30] == 0xb000)
		{
			Coop.players.tailsTailsAddress = address
			return address
		}
	}
	Coop.players.tailsTailsAddress = 0
	return 0
}


function void Coop.onPresenceMessage(u8 sender, u16 size)
{
	if (size < PRESENCE_SIZE || sender >= COOP_MAX_PLAYERS || sender == Net.getLocalPlayerId())
		return

	u32 block = Coop.getPlayerBlock(sender)
	if (u8[block] == 0)
	{
		// New player: no sprites or palette yet
		u8[block + 4] = 0
		u8[block + 5] = 0
		u8[block + 7] = 0
	}
	copyMemory(block + 0x10, COOP_MEM_RECV, PRESENCE_SIZE)
	u8[block] = 1
	u16[block + 2] = 0
}


function void Coop.onSpritesMessage(u8 sender, u16 size)
{
	if (size < 4 || sender >= COOP_MAX_PLAYERS || sender == Net.getLocalPlayerId())
		return

	u8 count = min(u8[COOP_MEM_RECV + 1], MAX_SPRITES)
	if (size < 4 + u16(count) * 0x20)
		return

	u32 block = Coop.getPlayerBlock(sender)
	copyMemory(block + 0x80, COOP_MEM_RECV + 4, u32(count) * 0x20)
	u8[block + 4] = count
	if (count > 0)
		u8[block + 7] = 1		// Sprite capture works for this player
}


function void Coop.onPaletteMessage(u8 sender, u16 size)
{
	if (size < 0x44 || sender >= COOP_MAX_PLAYERS || sender == Net.getLocalPlayerId())
		return

	u32 block = Coop.getPlayerBlock(sender)
	copyMemory(block + 0x40, COOP_MEM_RECV + 4, 0x40)
	u8[block + 5] = 1
	u8[block + 6] = u8[COOP_MEM_RECV + 1]
}


// Returns the palette slot (0..2) for a remote player, or 0xff if they don't get one
function u8 Coop.getPaletteSlot(u8 playerId)
{
	u8 slot = 0
	for (u8 id = 0; id < playerId; ++id)
	{
		u32 block = Coop.getPlayerBlock(id)
		if (u8[block] != 0 && u8[block + 5] != 0)
			++slot
	}
	return (slot < COOP_PALETTE_SLOTS) ? slot : 0xff
}


function void Coop.updateRemotePalettes()
{
	for (u8 id = 0; id < COOP_MAX_PLAYERS; ++id)
	{
		u32 block = Coop.getPlayerBlock(id)
		if (u8[block] == 0 || u8[block + 5] == 0)
			continue

		u8 slot = Coop.getPaletteSlot(id)
		if (slot == 0xff)
			continue

		// Palette lines 14+15, 12+13, 10+11 in the game's extended palette (normal and underwater variant),
		// filled from the top as the lower ones are more likely to be used by other mods
		copyMemory(0x802140 - u32(slot) * 0x40, block + 0x40, 0x40)
		copyMemory(0x802440 - u32(slot) * 0x40, block + 0x40, 0x40)
	}
}


function void Coop.drawRemotePlayers()
{
	// Make sure our own drawing of others doesn't get captured as part of our own character
	Renderer.clearSpriteTag()

	u16 ownStage = global.zone_act.apparent
	bool ownActTrans = (global.zone_act != global.zone_act.apparent)
	s32 screenWidth = getScreenWidth()
	s32 screenHeight = getScreenHeight()

	for (u8 id = 0; id < COOP_MAX_PLAYERS; ++id)
	{
		u32 block = Coop.getPlayerBlock(id)
		if (u8[block] == 0)
			continue

		u32 data = block + 0x10
		if (u16[data + 0x02] != ownStage)
			continue

		u8 flags = u8[data + 0x0c]
		s32 px = s32(u16[data + 0x04]) - s32(camera.foreground.x.u16)
		s32 py = s32(u16[data + 0x06]) - s32(camera.foreground.y.u16)

		// Seamless act transitions shift level coordinates (same fix-ups as the game's Ghost Sync)
		u8 zone = (ownStage >> 8)
		bool otherActTrans = (flags & PRESENCE_FLAG_ACT_TRANS) != 0
		if (zone == 0x00)
		{
			if (otherActTrans)
			{
				px += 0x2f00
				py += 0x80
			}
			if (ownActTrans)
			{
				px -= 0x2f00
				py -= 0x80
			}
		}
		else if (zone == 0x05)
		{
			if (otherActTrans)
			{
				px += 0x6880
				py -= 0x100
			}
			if (ownActTrans)
			{
				px -= 0x6880
				py += 0x100
			}
		}

		// Vertical level wrap
		if (level.vertical_wrap == 0xff00)
		{
			py &= level.height.bitmask
			if (py >= s32(level.height.bitmask / 2))
				py -= s32(level.height.bitmask) + 1
		}

		bool onScreen = (px > -48 && px < screenWidth + 48 && py > -48 && py < screenHeight + 48)
		if (onScreen)
		{
			if (flags & PRESENCE_FLAG_VISIBLE)
			{
				u8 alpha = (Coop.setting.opacity == 1) ? 0xa0 : 0xff
				Coop.drawRemotePlayer(id, px, py, alpha, 0x100)
			}

			if (Coop.setting.showNames)
			{
				Renderer.drawText("oxyfont_tiny:gradient:outline(0x000000ff,1,false)", px, py - 28, Net.getPlayerName(id), 0xffffffff, 5, 0, 0x9f80, false)
			}
		}
		else if (Coop.setting.showOffscreen)
		{
			// Small marker at the screen border, pointing towards the player
			s32 halfx = screenWidth / 2
			s32 halfy = screenHeight / 2
			s32 dx = px - halfx
			s32 dy = py - halfy
			s32 maxX = halfx * 19/20
			s32 maxY = halfy * 19/20
			if (abs(dx) > maxX)
			{
				dy = dy * maxX / abs(dx)
				dx = (dx > 0) ? maxX : -maxX
			}
			if (abs(dy) > maxY)
			{
				dx = dx * maxY / abs(dy)
				dy = (dy > 0) ? maxY : -maxY
			}
			Coop.drawRemotePlayer(id, halfx + dx, halfy + dy, 0xc0, 0x80)
		}
	}
}


// Draws a remote player at screen position (px, py); scale is 8.8 fixed point (0x100 = normal size)
function void Coop.drawRemotePlayer(u8 id, s32 px, s32 py, u8 alpha, s32 scale)
{
	u32 block = Coop.getPlayerBlock(id)
	u32 data = block + 0x10
	u8 character = u8[data + 0x01]

	// Palette: sprites using the sender's character palette lines get redirected to that player's palette slot
	u8 slot = (u8[block + 5] != 0) ? Coop.getPaletteSlot(id) : 0xff
	u16 senderPaletteBase = 0x40 + u16(u8[block + 6]) * 0x20
	u16 slotPaletteBase = (slot != 0xff) ? (0xe0 - u16(slot) * 0x20) : 0

	// Replay the exact sprites the sender drew, if we have them
	u8 count = u8[block + 4]

	// Original character sprites are built from the ROM on first use, so a sprite the sender drew may not exist here yet
	//  -> Build the ones the sender could be using now, so their keys exist too (keys from the ROM are the same on every PC)
	u8 missing = 0
	for (u8 i = 0; i < count; ++i)
	{
		if (!Renderer.hasCustomSprite(u64[block + 0x80 + u32(i) * 0x20]))
			++missing
	}
	if (missing > 0)
	{
		Coop.prepareOriginalSprites(data)
		missing = 0
		for (u8 i = 0; i < count; ++i)
		{
			if (!Renderer.hasCustomSprite(u64[block + 0x80 + u32(i) * 0x20]))
				++missing
		}
	}

	// If most of it is missing (e.g. we don't have the sender's character mod), draw the original character instead
	bool replay = (count > 0 && missing * 2 < count)

	u8 drawn = 0
	for (u8 i = 0; replay && i < count; ++i)
	{
		u32 sprite = block + 0x80 + u32(i) * 0x20
		u64 key = u64[sprite]
		if (!Renderer.hasCustomSprite(key))
			continue

		u16 atex = u16[sprite + 0x0c]
		if (slot != 0xff && atex >= senderPaletteBase && atex < senderPaletteBase + 0x20)
			atex = slotPaletteBase + (atex - senderPaletteBase)

		s32 dx = s32(s16[sprite + 0x08]) * scale / 0x100
		s32 dy = s32(s16[sprite + 0x0a]) * scale / 0x100
		s32 m11 = s32(s16[sprite + 0x12]) * scale
		s32 m12 = s32(s16[sprite + 0x14]) * scale
		s32 m21 = s32(s16[sprite + 0x16]) * scale
		s32 m22 = s32(s16[sprite + 0x18]) * scale

		u32 tint = u32[sprite + 0x1c]
		tint = (tint & 0xffffff00) | ((tint & 0xff) * u32(alpha) / 0xff)
		u16 renderQueue = (scale == 0x100) ? (u16[sprite + 0x10] - 1 - u16(id)) : (0xa800 + i)

		if (scale == 0x100)
		{
			// Normal size: exact replay incl. rotation, scaling and flipping
			Renderer.drawSpriteTransformed(key, px + dx, py + dy, atex, u8[sprite + 0x0e], renderQueue, tint, m11, m12, m21, m22)
		}
		else
		{
			// Off-screen marker: same drawing path as the game's own off-screen Tails marker (no rotation, just flipping),
			// always in front of the level
			u8 markerFlags = SPRITE_FLAG_PRIO
			if (s16[sprite + 0x12] < 0)
				markerFlags |= SPRITE_FLAG_FLIP_X
			if (s16[sprite + 0x18] < 0)
				markerFlags |= SPRITE_FLAG_FLIP_Y
			Renderer.drawCustomSprite(key, px + dx, py + dy, u8(atex), markerFlags, renderQueue, 0, tint, scale * 0x100)
		}
		++drawn
	}

	// Sender drew nothing (e.g. blinking) -> draw nothing as well, instead of falling back to the original character
	if (count == 0 && u8[block + 7] != 0)
		return

	if (drawn == 0)
	{
		// Nothing usable received (or none of the sprites exist here): draw the original character instead
		u16 atex = (slot != 0xff && u8[block + 6] == min(character, CHARACTER_KNUCKLES)) ? slotPaletteBase : (0x40 + u16(min(character, CHARACTER_KNUCKLES)) * 0x20)
		u16 renderQueue = (scale == 0x100) ? (0x9f00 - u16(id) * 2) : 0xa800
		Coop.drawOriginalCharacter(data, px, py, alpha, scale * 0x100, renderQueue, atex)
	}
}


// Builds the original (ROM) sprites a remote player could currently be shown with: their animation frame,
// the frame as remapped for smooth rotation, and Tails' tails
function void Coop.prepareOriginalSprites(u32 data)
{
	u8 character = u8[data + 0x01]
	if (character > CHARACTER_KNUCKLES)
		return

	bool isSuper = (u8[data + 0x0c] & PRESENCE_FLAG_SUPER) != 0
	u8 animationSprite = u8[data + 0x0a]
	Coop.setupOriginalCharacterSprite(character, animationSprite, isSuper)
	Coop.setupOriginalCharacterSprite(character, animationSprite, !isSuper)

	if (animationSprite >= 0x01 && animationSprite <= 0x20)
		Coop.setupOriginalCharacterSprite(character, 0x01 + (animationSprite - 0x01) % 8, isSuper)
	else if (animationSprite >= 0x21 && animationSprite <= 0x30)
		Coop.setupOriginalCharacterSprite(character, 0x21 + (animationSprite - 0x21) % 4, isSuper)
	else if (character == CHARACTER_TAILS && animationSprite >= 0xc3 && animationSprite <= 0xca)
		Coop.setupOriginalCharacterSprite(character, 0xc3 + (animationSprite - 0xc3) % 2, isSuper)

	u8 tailsSprite = u8[data + 0x0d]
	if (character == CHARACTER_TAILS && tailsSprite != 0)
	{
		Renderer.setupCustomCharacterSprite(0x336620, 0x344d74, 0x344bb8, tailsSprite, 0x00)
		if (tailsSprite >= 0x05 && tailsSprite <= 0x14)
			Renderer.setupCustomCharacterSprite(0x336620, 0x344d74, 0x344bb8, 0x05 + (tailsSprite - 0x05) % 4, 0x00)
	}
}

function u64 Coop.setupOriginalCharacterSprite(u8 character, u8 animationSprite, bool isSuper)
{
	u32 sourceBase    = (character == CHARACTER_SONIC) ? ((animationSprite >= 0xda) ? 0x140060 : 0x100000) : (character == CHARACTER_TAILS) ? ((animationSprite >= 0xd1) ? 0x143d00 : 0x3200e0) : 0x1200e0
	u32 tableAddress  = (character == CHARACTER_SONIC) ? (isSuper ? 0x148378 : 0x148182) : (character == CHARACTER_TAILS) ? 0x14a08a : 0x14bd0a
	u32 mappingOffset = (character == CHARACTER_SONIC) ? (isSuper ? 0x146816 : 0x146620) : (character == CHARACTER_TAILS) ? 0x148eb8 : 0x14a8d6
	return Renderer.setupCustomCharacterSprite(sourceBase, tableAddress, mappingOffset, animationSprite, 0x00)
}


// Fallback: draws a remote character with its original sprites from the ROM, based on its presence data
function void Coop.drawOriginalCharacter(u32 data, s32 px, s32 py, u8 alpha, s32 scale, u16 renderQueue, u16 atex)
{
	u8 character = min(u8[data + 0x01], CHARACTER_KNUCKLES)
	u16 animationSpriteEx = u16[data + 0x08]
	u8 animationSprite = u8[data + 0x0a]
	u8 rotation = u8[data + 0x0b]
	u8 flags = u8[data + 0x0c]
	bool isSuper = (flags & PRESENCE_FLAG_SUPER) != 0

	u8 spriteFlags = flags & (PRESENCE_FLAG_FLIP_X | PRESENCE_FLAG_FLIP_Y)
	u8 angle = 0

	// Smooth rotation for walking / running sprites, if the viewer has it enabled
	if (Game.getSetting(SETTING_SMOOTH_ROTATION) && animationSpriteEx < 0x100)
	{
		bool rotates = false
		if (animationSprite >= 0x01 && animationSprite <= 0x20)
		{
			animationSprite = 0x01 + (animationSprite - 0x01) % 8
			rotates = true
		}
		else if (animationSprite >= 0x21 && animationSprite <= 0x30)
		{
			animationSprite = 0x21 + (animationSprite - 0x21) % 4
			rotates = true
		}
		else if (character == CHARACTER_TAILS && animationSprite >= 0xc3 && animationSprite <= 0xca)
		{
			animationSprite = 0xc3 + (animationSprite - 0xc3) % 2
			rotates = true
		}

		if (rotates)
		{
			spriteFlags = (flags & PRESENCE_FLAG_FACING_LEFT) ? SPRITE_FLAG_FLIP_X : 0
			angle = (abs(s8(rotation)) <= 0x10) ? 0 : rotation
		}
	}

	if ((flags & PRESENCE_FLAG_PRIORITY) || scale != 0x10000)		// Off-screen markers always go in front of the level
		spriteFlags |= SPRITE_FLAG_PRIO

	// Original sprites only, built straight from the ROM, so the viewer's own character mods don't apply
	u64 key = 0
	if (animationSpriteEx >= 0x100 && character == CHARACTER_SONIC)
	{
		if (animationSpriteEx >= CHAR_ANIMSPRITE_SONIC_PEELOUT)
			key = stringformat("sonic_peelout_%d", animationSpriteEx - CHAR_ANIMSPRITE_SONIC_PEELOUT)
		else
			key = stringformat("sonic_dropdash_%d", animationSpriteEx - CHAR_ANIMSPRITE_SONIC_DROPDASH)
	}
	else
	{
		key = Coop.setupOriginalCharacterSprite(character, animationSprite, isSuper)
	}

	u32 tint = 0xffffff00 | u32(alpha)		// RGBA

	// Tails' tails go behind Tails
	u8 tailsSprite = u8[data + 0x0d]
	if (character == CHARACTER_TAILS && tailsSprite != 0)
	{
		u8 tailsFlags = spriteFlags & 0xbf		// Without SPRITE_FLAG_PRIO
		u8 tailsAngle = 0
		if (Game.getSetting(SETTING_SMOOTH_ROTATION) && tailsSprite >= 0x05 && tailsSprite <= 0x14)
		{
			tailsSprite = 0x05 + (tailsSprite - 0x05) % 4
			tailsAngle = u8[data + 0x0e]
			tailsFlags = 0
			if (flags & PRESENCE_FLAG_FACING_LEFT)
			{
				tailsFlags = SPRITE_FLAG_FLIP_X
				tailsAngle += 0x80
			}
		}
		if ((flags & PRESENCE_FLAG_PRIORITY) || scale != 0x10000)
			tailsFlags |= SPRITE_FLAG_PRIO

		u64 tailsKey = Renderer.setupCustomCharacterSprite(0x336620, 0x344d74, 0x344bb8, tailsSprite, 0x00)
		Renderer.drawCustomSprite(tailsKey, px, py, atex, tailsFlags, renderQueue - 1, tailsAngle, tint, scale)
	}

	Renderer.drawCustomSprite(key, px, py, atex, spriteFlags, renderQueue, angle, tint, scale)
}
