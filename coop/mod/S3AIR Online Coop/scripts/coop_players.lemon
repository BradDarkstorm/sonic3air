//-------------------------------------------------------//
// Online Co-op: see the other players                   //
//-------------------------------------------------------//

global u8   Coop.players.sendCounter
global u32  Coop.players.tailsTailsAddress		// Cached address of player 1's Tails' tails object


function void Coop.playersUpdate()
{
	if (!Net.isOnline())
	{
		// Forget everyone
		for (u8 id = 0; id < COOP_MAX_PLAYERS; ++id)
			u8[Coop.getPlayerBlock(id)] = 0
		return
	}

	// Age remote player data, drop players without updates for 3 seconds or who left
	for (u8 id = 0; id < COOP_MAX_PLAYERS; ++id)
	{
		u32 block = Coop.getPlayerBlock(id)
		if (u8[block] == 0)
			continue

		u16[block + 2] += 1
		if (u16[block + 2] > 180 || !Net.isPlayerConnected(id) || id == Net.getLocalPlayerId())
			u8[block] = 0
	}

	if (!Coop.isInLevel())
		return

	// Send own state every 2nd frame (30 per second)
	++Coop.players.sendCounter
	if ((Coop.players.sendCounter & 1) == 0)
	{
		Coop.sendPresence()
	}

	Coop.drawRemotePlayers()
}


function void Coop.sendPresence()
{
	A0 = 0xffffb000
	if (objA0.update_address == 0)
		return

	u32 msg = COOP_MEM_SEND
	u8[msg + 0x00] = MSG_PRESENCE
	u8[msg + 0x01] = char.character
	u16[msg + 0x02] = global.zone_act.apparent
	u16[msg + 0x04] = char.position.x.u16
	u16[msg + 0x06] = char.position.y.u16
	u16[msg + 0x08] = timeattack.animSpriteEx		// Written by the game's own character rendering each frame
	u8[msg + 0x0a] = char.animation.sprite
	u8[msg + 0x0b] = char.rotation

	u8 flags = (char.render_flags & 0x03)
	if (char.sprite_attributes & sprite_attribute.PRIORITY)
		flags |= PRESENCE_FLAG_PRIORITY
	bool isSuper = (char.character == CHARACTER_TAILS) ? (super.active.tails != 0) : (super.active != 0)
	if (isSuper)
		flags |= PRESENCE_FLAG_SUPER
	if (global.zone_act != global.zone_act.apparent)
		flags |= PRESENCE_FLAG_ACT_TRANS
	if (char.flags & char.flag.FACING_LEFT)
		flags |= PRESENCE_FLAG_FACING_LEFT

	// Hidden while blinking after a hit (same rule the game uses)
	bool blinkHidden = (u8[A0 + 0x34] != 0 && ((u8[A0 + 0x34] + 1) & 0x04) == 0)
	if (!blinkHidden && (char.render_flags & 0x80))		// 0x80 = "on screen" / visible render flag
		flags |= PRESENCE_FLAG_VISIBLE
	u8[msg + 0x0c] = flags

	// Tails' tails
	u8[msg + 0x0d] = 0
	u8[msg + 0x0e] = 0
	if (char.character == CHARACTER_TAILS)
	{
		u32 tailsAddress = Coop.findTailsTails()
		if (tailsAddress != 0)
		{
			u8[msg + 0x0d] = u8[tailsAddress + 0x22]
			u8[msg + 0x0e] = lookupAngleByVector(char.velocity.x, char.velocity.y)
		}
	}
	u8[msg + 0x0f] = 0

	Net.send(NET_TARGET_ALL, msg, PRESENCE_SIZE, false)
}


function u32 Coop.findTailsTails()
{
	// Check cached address first
	u32 address = Coop.players.tailsTailsAddress
	if (address != 0 && u32[address + 0x0c] == 0x344bb8 && u16[address + 0x30] == 0xb000)
		return address

	for (address = 0xffffb04a; address < 0xffffcfcb; address += 0x4a)
	{
		if (u32[address + 0x0c] == 0x344bb8 && u16[address + 0x30] == 0xb000)
		{
			Coop.players.tailsTailsAddress = address
			return address
		}
	}
	Coop.players.tailsTailsAddress = 0
	return 0
}


function void Coop.onPresenceMessage(u8 sender, u16 size)
{
	if (size < PRESENCE_SIZE || sender >= COOP_MAX_PLAYERS || sender == Net.getLocalPlayerId())
		return

	u32 block = Coop.getPlayerBlock(sender)
	copyMemory(block + 0x10, COOP_MEM_RECV, PRESENCE_SIZE)
	u8[block] = 1
	u16[block + 2] = 0
}


function void Coop.drawRemotePlayers()
{
	u16 ownStage = global.zone_act.apparent
	bool ownActTrans = (global.zone_act != global.zone_act.apparent)
	s32 screenWidth = getScreenWidth()
	s32 screenHeight = getScreenHeight()

	for (u8 id = 0; id < COOP_MAX_PLAYERS; ++id)
	{
		u32 block = Coop.getPlayerBlock(id)
		if (u8[block] == 0)
			continue

		u32 data = block + 0x10
		if (u16[data + 0x02] != ownStage)
			continue

		u8 flags = u8[data + 0x0c]
		s32 px = s32(u16[data + 0x04]) - s32(camera.foreground.x.u16)
		s32 py = s32(u16[data + 0x06]) - s32(camera.foreground.y.u16)

		// Seamless act transitions shift level coordinates (same fix-ups as the game's Ghost Sync)
		u8 zone = (ownStage >> 8)
		bool otherActTrans = (flags & PRESENCE_FLAG_ACT_TRANS) != 0
		if (zone == 0x00)
		{
			if (otherActTrans)
			{
				px += 0x2f00
				py += 0x80
			}
			if (ownActTrans)
			{
				px -= 0x2f00
				py -= 0x80
			}
		}
		else if (zone == 0x05)
		{
			if (otherActTrans)
			{
				px += 0x6880
				py -= 0x100
			}
			if (ownActTrans)
			{
				px -= 0x6880
				py += 0x100
			}
		}

		// Vertical level wrap
		if (level.vertical_wrap == 0xff00)
		{
			py &= level.height.bitmask
			if (py >= s32(level.height.bitmask / 2))
				py -= s32(level.height.bitmask) + 1
		}

		bool onScreen = (px > -32 && px < screenWidth + 32 && py > -32 && py < screenHeight + 32)
		if (onScreen)
		{
			if (flags & PRESENCE_FLAG_VISIBLE)
			{
				u8 alpha = (Coop.setting.opacity == 1) ? 0xa0 : 0xff
				Coop.drawPresenceSprite(data, px, py, alpha, 0x10000, 0x9f00 - u16(id) * 2)
			}

			if (Coop.setting.showNames)
			{
				Renderer.drawText("oxyfont_tiny:gradient:outline(0x000000ff,1,false)", px, py - 28, Net.getPlayerName(id), 0xffffffff, 5, 0, 0x9f80, false)
			}
		}
		else if (Coop.setting.showOffscreen)
		{
			// Small marker at the screen border, pointing towards the player
			s32 halfx = screenWidth / 2
			s32 halfy = screenHeight / 2
			s32 dx = px - halfx
			s32 dy = py - halfy
			s32 maxX = halfx * 19/20
			s32 maxY = halfy * 19/20
			if (abs(dx) > maxX)
			{
				dy = dy * maxX / abs(dx)
				dx = (dx > 0) ? maxX : -maxX
			}
			if (abs(dy) > maxY)
			{
				dx = dx * maxY / abs(dy)
				dy = (dy > 0) ? maxY : -maxY
			}
			Coop.drawPresenceSprite(data, halfx + dx, halfy + dy, 0xc0, 0x8000, 0xa800)
		}
	}
}


// Draws a remote character from its presence data.
// Goes through "Standalone.getModdedAnimationSpriteKey", so character mods that use the game's official hook
// also show up for remote players -- as long as the viewer has that mod enabled too.
function void Coop.drawPresenceSprite(u32 data, s32 px, s32 py, u8 alpha, s32 scale, u16 renderQueue)
{
	u8 character = u8[data + 0x01]
	u16 animationSpriteEx = u16[data + 0x08]
	u8 animationSprite = u8[data + 0x0a]
	u8 rotation = u8[data + 0x0b]
	u8 flags = u8[data + 0x0c]
	bool isSuper = (flags & PRESENCE_FLAG_SUPER) != 0

	u8 spriteFlags = flags & (PRESENCE_FLAG_FLIP_X | PRESENCE_FLAG_FLIP_Y)
	u8 angle = 0

	// Smooth rotation for walking / running sprites, if the viewer has it enabled
	if (Game.getSetting(SETTING_SMOOTH_ROTATION) && animationSpriteEx < 0x100)
	{
		bool rotates = false
		if (animationSprite >= 0x01 && animationSprite <= 0x20)
		{
			animationSprite = 0x01 + (animationSprite - 0x01) % 8
			rotates = true
		}
		else if (animationSprite >= 0x21 && animationSprite <= 0x30)
		{
			animationSprite = 0x21 + (animationSprite - 0x21) % 4
			rotates = true
		}
		else if (character == CHARACTER_TAILS && animationSprite >= 0xc3 && animationSprite <= 0xca)
		{
			animationSprite = 0xc3 + (animationSprite - 0xc3) % 2
			rotates = true
		}

		if (rotates)
		{
			spriteFlags = (flags & PRESENCE_FLAG_FACING_LEFT) ? SPRITE_FLAG_FLIP_X : 0
			angle = (abs(s8(rotation)) <= 0x10) ? 0 : rotation
		}
	}

	if (flags & PRESENCE_FLAG_PRIORITY)
		spriteFlags |= SPRITE_FLAG_PRIO

	// Find the sprite key: modded scripts first, then the same fallbacks the game uses
	u64 key = Standalone.getModdedAnimationSpriteKey(character, animationSpriteEx)
	if (key == 0 && animationSpriteEx >= 0x100)
	{
		if (animationSpriteEx >= CHAR_ANIMSPRITE_SONIC_PEELOUT)
			key = stringformat("sonic_peelout_%d", animationSpriteEx - CHAR_ANIMSPRITE_SONIC_PEELOUT)
		else
			key = stringformat("sonic_dropdash_%d", animationSpriteEx - CHAR_ANIMSPRITE_SONIC_DROPDASH)
	}
	if (key == 0)
	{
		key = stringformat(stringformat("%s_0x%02x", getCharacterSpriteKey(character, isSuper)), animationSprite)
		if (!Renderer.hasCustomSprite(key) && character <= CHARACTER_KNUCKLES)
		{
			u32 sourceBase    = (character == CHARACTER_SONIC) ? ((animationSprite >= 0xda) ? 0x140060 : 0x100000) : (character == CHARACTER_TAILS) ? ((animationSprite >= 0xd1) ? 0x143d00 : 0x3200e0) : 0x1200e0
			u32 tableAddress  = (character == CHARACTER_SONIC) ? (isSuper ? 0x148378 : 0x148182) : (character == CHARACTER_TAILS) ? 0x14a08a : 0x14bd0a
			u32 mappingOffset = (character == CHARACTER_SONIC) ? (isSuper ? 0x146816 : 0x146620) : (character == CHARACTER_TAILS) ? 0x148eb8 : 0x14a8d6
			key = Renderer.setupCustomCharacterSprite(sourceBase, tableAddress, mappingOffset, animationSprite, 0x00)
		}
	}

	u8 atex = 0x40 + min(character, CHARACTER_KNUCKLES) * 0x20
	u32 tint = 0xffffff00 | u32(alpha)		// RGBA

	// Tails' tails go behind Tails
	u8 tailsSprite = u8[data + 0x0d]
	if (character == CHARACTER_TAILS && tailsSprite != 0)
	{
		u8 tailsFlags = spriteFlags & 0xbf		// Without SPRITE_FLAG_PRIO
		u8 tailsAngle = 0
		if (Game.getSetting(SETTING_SMOOTH_ROTATION) && tailsSprite >= 0x05 && tailsSprite <= 0x14)
		{
			tailsSprite = 0x05 + (tailsSprite - 0x05) % 4
			tailsAngle = u8[data + 0x0e]
			tailsFlags = 0
			if (flags & PRESENCE_FLAG_FACING_LEFT)
			{
				tailsFlags = SPRITE_FLAG_FLIP_X
				tailsAngle += 0x80
			}
		}
		if (flags & PRESENCE_FLAG_PRIORITY)
			tailsFlags |= SPRITE_FLAG_PRIO

		u64 tailsKey = stringformat(stringformat("%s_tails_0x%02x", getCharacterSpriteKey(CHARACTER_TAILS, false)), tailsSprite)
		if (!Renderer.hasCustomSprite(tailsKey))
			tailsKey = Renderer.setupCustomCharacterSprite(0x336620, 0x344d74, 0x344bb8, tailsSprite, 0x00)
		Renderer.drawCustomSprite(tailsKey, px, py, atex, tailsFlags, renderQueue - 1, tailsAngle, tint, scale)
	}

	Renderer.drawCustomSprite(key, px, py, atex, spriteFlags, renderQueue, angle, tint, scale)
}
